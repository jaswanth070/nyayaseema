# --- Required for live Razorpay (Razorpay Dashboard -> Settings -> API Keys) ---
# Leave both unset to run in demo mode with a simulated gateway.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Recommended: long random string used to sign order/receipt tokens and CustomsQR passes ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, RAZORPAY_KEY_SECRET is used instead.
SIGNING_SECRET=

# No webhook is used, so there is no RAZORPAY_WEBHOOK_SECRET.
