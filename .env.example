# Razorpay credentials (Dashboard -> Settings -> API Keys). Leave unset to run in demo (mock) mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard -> Settings -> Webhooks -> Add new webhook
#   URL:    https://<your-host>/api/razorpay/webhook
#   Events: payment.captured, payment.failed, order.paid
#   Secret: the value you set here
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string

# Optional: HMAC key used to sign CustomsQR certificates
CERT_SIGNING_SECRET=choose_another_long_random_string
